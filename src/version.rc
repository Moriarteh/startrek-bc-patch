// Version resource for binkw32.dll (the community patch).
// Gives the file proper identification instead of a blank version block.

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Moriarteh"
            VALUE "FileDescription",  "Star Trek: Bridge Commander Community Patch"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",      "binkw32"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Moriarteh. Unofficial community patch."
            VALUE "OriginalFilename", "binkw32.dll"
            VALUE "ProductName",      "Star Trek: Bridge Commander Community Patch"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
